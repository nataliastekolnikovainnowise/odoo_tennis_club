<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========== HR EMPLOYEE (Trainers) ========== -->
    <record id="rule_employee_manager" model="ir.rule">
        <field name="name">Manager: Own Center Trainers Only</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('group_tennis_manager'))]"/>
        <field name="domain_force">[('center_id.manager_id.user_id', '=', user.id)]</field>
    </record>
    
    <record id="rule_employee_director" model="ir.rule">
        <field name="name">Director: All Employees</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('group_tennis_director'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- ========== CENTERS ========== -->
    <!-- Trainer can only see their own center -->
    <record id="rule_center_trainer" model="ir.rule">
        <field name="name">Trainer: Own Center Only</field>
        <field name="model_id" ref="model_tennis_center"/>
        <field name="groups" eval="[(4, ref('group_tennis_trainer'))]"/>
        <field name="domain_force">[('id', '=', user.employee_ids.center_id.id)]</field>
    </record>

    <record id="rule_center_manager" model="ir.rule">
        <field name="name">Manager: Own Centers Only</field>
        <field name="model_id" ref="model_tennis_center"/>
        <field name="groups" eval="[(4, ref('group_tennis_manager'))]"/>
        <field name="domain_force">[('manager_id.user_id', '=', user.id)]</field>
    </record>
    
    <record id="rule_center_director" model="ir.rule">
        <field name="name">Director: All Centers</field>
        <field name="model_id" ref="model_tennis_center"/>
        <field name="groups" eval="[(4, ref('group_tennis_director'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

