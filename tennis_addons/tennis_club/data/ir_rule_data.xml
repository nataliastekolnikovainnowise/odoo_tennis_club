<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">

    <!-- Отключаем стандартное multi-company правило HR -->
    <record id="hr.hr_employee_rule" model="ir.rule">
      <field name="active" eval="False"/>
    </record>

    <!-- ===== DIRECTOR: видит всё ===== -->
    <record id="rule_center_director_all" model="ir.rule">
      <field name="name">Director: All Centers</field>
      <field name="model_id" ref="model_tennis_center"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_director'))]"/>
      <field name="domain_force">[(1,'=',1)]</field>
    </record>
    <record id="rule_court_director_all" model="ir.rule">
      <field name="name">Director: All Courts</field>
      <field name="model_id" ref="model_tennis_court"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_director'))]"/>
      <field name="domain_force">[(1,'=',1)]</field>
    </record>
    <record id="rule_lesson_director_all" model="ir.rule">
      <field name="name">Director: All Sessions</field>
      <field name="model_id" ref="model_tennis_training_session"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_director'))]"/>
      <field name="domain_force">[(1,'=',1)]</field>
    </record>
    <record id="rule_schedule_director_all" model="ir.rule">
      <field name="name">Director: All Schedules</field>
      <field name="model_id" ref="model_court_schedule"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_director'))]"/>
      <field name="domain_force">[(1,'=',1)]</field>
    </record>
    <record id="rule_schedule_status_director_all" model="ir.rule">
      <field name="name">Director: All Schedule Statuses</field>
      <field name="model_id" ref="model_court_schedule_status"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_director'))]"/>
      <field name="domain_force">[(1,'=',1)]</field>
    </record>
    <record id="rule_time_slot_director_all" model="ir.rule">
      <field name="name">Director: All Session Time Slots</field>
      <field name="model_id" ref="model_tennis_training_session_time_slot"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_director'))]"/>
      <field name="domain_force">[(1,'=',1)]</field>
    </record>
    <record id="rule_availability_director_all" model="ir.rule">
      <field name="name">Director: All Trainer Availability</field>
      <field name="model_id" ref="model_tennis_trainer_availability"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_director'))]"/>
      <field name="domain_force">[(1,'=',1)]</field>
    </record>
    <record id="rule_center_price_director_all" model="ir.rule">
      <field name="name">Director: All Center Prices</field>
      <field name="model_id" ref="model_tennis_center_price"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_director'))]"/>
      <field name="domain_force">[(1,'=',1)]</field>
    </record>
    <record id="rule_trainer_rate_director_all" model="ir.rule">
      <field name="name">Director: All Trainer Rates</field>
      <field name="model_id" ref="model_tennis_trainer_rate"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_director'))]"/>
      <field name="domain_force">[(1,'=',1)]</field>
    </record>

    <!-- ===== MANAGER: только свой центр ===== -->
    <record id="rule_center_manager_own" model="ir.rule">
      <field name="name">Manager: Own Center</field>
      <field name="model_id" ref="model_tennis_center"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_manager'))]"/>
      <field name="domain_force">[('id','=',user.employee_id.center_id.id)]</field>
    </record>
    <record id="rule_court_manager_own" model="ir.rule">
      <field name="name">Manager: Courts of Own Center</field>
      <field name="model_id" ref="model_tennis_court"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_manager'))]"/>
      <field name="domain_force">[('center_id','=',user.employee_id.center_id.id)]</field>
    </record>
    <record id="rule_lesson_manager_own" model="ir.rule">
      <field name="name">Manager: Sessions of Own Center</field>
      <field name="model_id" ref="model_tennis_training_session"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_manager'))]"/>
      <field name="domain_force">[('center_id','=',user.employee_id.center_id.id)]</field>
    </record>
    <record id="rule_schedule_manager_own" model="ir.rule">
      <field name="name">Manager: Schedules of Own Center</field>
      <field name="model_id" ref="model_court_schedule"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_manager'))]"/>
      <field name="domain_force">[('center_id','=',user.employee_id.center_id.id)]</field>
    </record>
    <record id="rule_schedule_status_manager_own" model="ir.rule">
      <field name="name">Manager: Schedule Statuses (All)</field>
      <field name="model_id" ref="model_court_schedule_status"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_manager'))]"/>
      <field name="domain_force">[(1,'=',1)]</field>
    </record>
    <record id="rule_time_slot_manager_own" model="ir.rule">
      <field name="name">Manager: Session Time Slots (Own Center)</field>
      <field name="model_id" ref="model_tennis_training_session_time_slot"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_manager'))]"/>
      <field name="domain_force">[('center_id','=',user.employee_id.center_id.id)]</field>
    </record>
    <record id="rule_availability_manager_own" model="ir.rule">
      <field name="name">Manager: Trainer Availability (Own Center)</field>
      <field name="model_id" ref="model_tennis_trainer_availability"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_manager'))]"/>
      <field name="domain_force">[('center_id','=',user.employee_id.center_id.id)]</field>
    </record>
    <record id="rule_center_price_manager_own" model="ir.rule">
      <field name="name">Manager: Center Prices (Own Center)</field>
      <field name="model_id" ref="model_tennis_center_price"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_manager'))]"/>
      <field name="domain_force">[('center_id','=',user.employee_id.center_id.id)]</field>
    </record>
    <record id="rule_trainer_rate_manager_own" model="ir.rule">
      <field name="name">Manager: Trainer Rates (Own Center)</field>
      <field name="model_id" ref="model_tennis_trainer_rate"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_manager'))]"/>
      <field name="domain_force">[('center_id','=',user.employee_id.center_id.id)]</field>
    </record>

    <!-- ===== TRAINER: свой центр + только свои тренировки ===== -->
    <record id="rule_center_trainer_own" model="ir.rule">
      <field name="name">Trainer: Own Center</field>
      <field name="model_id" ref="model_tennis_center"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_trainer'))]"/>
      <field name="domain_force">[('id','=',user.employee_id.center_id.id)]</field>
    </record>
    <record id="rule_court_trainer_own" model="ir.rule">
      <field name="name">Trainer: Courts of Own Center</field>
      <field name="model_id" ref="model_tennis_court"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_trainer'))]"/>
      <field name="domain_force">[('center_id','=',user.employee_id.center_id.id)]</field>
    </record>
    <record id="rule_lesson_trainer_own" model="ir.rule">
      <field name="name">Trainer: Own Sessions Only</field>
      <field name="model_id" ref="model_tennis_training_session"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_trainer'))]"/>
      <field name="domain_force">[('center_id','=',user.employee_id.center_id.id), ('trainer_id.user_id','=',user.id)]</field>
    </record>
    <record id="rule_schedule_trainer_own" model="ir.rule">
      <field name="name">Trainer: Schedules (Own Center)</field>
      <field name="model_id" ref="model_court_schedule"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_trainer'))]"/>
      <field name="domain_force">[('center_id','=',user.employee_id.center_id.id)]</field>
    </record>
    <record id="rule_time_slot_trainer_own" model="ir.rule">
      <field name="name">Trainer: Session Time Slots (Own Center)</field>
      <field name="model_id" ref="model_tennis_training_session_time_slot"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_trainer'))]"/>
      <field name="domain_force">[('center_id','=',user.employee_id.center_id.id)]</field>
    </record>
    <record id="rule_availability_trainer_own" model="ir.rule">
      <field name="name">Trainer: His Availability</field>
      <field name="model_id" ref="model_tennis_trainer_availability"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_trainer'))]"/>
      <field name="domain_force">[('center_id','=',user.employee_id.center_id.id), ('trainer_id.user_id','=',user.id)]</field>
    </record>


    <!-- Manager: Revenue Report Lines (Own Center Trainers) -->
    <record id="rule_revenue_line_manager_own" model="ir.rule">
      <field name="name">Manager: Revenue Lines (Own Center Trainers)</field>
      <field name="model_id" ref="model_tennis_trainer_revenue_report_line"/>
      <field name="groups" eval="[(4, ref('tennis_club.group_tennis_manager'))]"/>
      <field name="domain_force">[('trainer_id.center_id','=',user.employee_id.center_id.id)]</field>
    </record>



  </data>
</odoo>
