<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <record id="training_type_individual" model="tennis.training.type">
            <field name="name">Individual</field>
            <field name="code">individual</field>
            <field name="min_clients">1</field>
            <field name="max_clients">1</field>
            <field name="description">One-on-one training with a coach</field>
            <field name="sequence">1</field>
            <field name="color">1</field>
        </record>

        <record id="training_type_split" model="tennis.training.type">
            <field name="name">Split</field>
            <field name="code">split</field>
            <field name="min_clients">2</field>
            <field name="max_clients">2</field>
            <field name="description">Two clients training with a coach</field>
            <field name="sequence">2</field>
            <field name="color">2</field>
        </record>

        <record id="training_type_group" model="tennis.training.type">
            <field name="name">Group</field>
            <field name="code">group</field>
            <field name="min_clients">3</field>
            <field name="max_clients">5</field>
            <field name="description">Group training with 3-5 clients and a coach</field>
            <field name="sequence">3</field>
            <field name="color">3</field>
        </record>

    </data>
</odoo>
