<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- List View -->
    <record id="view_tennis_center_price_list" model="ir.ui.view">
        <field name="name">tennis.center.price.list</field>
        <field name="model">tennis.center.price</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="center_id"/>
                <field name="training_type_id"/>
                <field name="price" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    
    <!-- Form View -->
    <record id="view_tennis_center_price_form" model="ir.ui.view">
        <field name="name">tennis.center.price.form</field>
        <field name="model">tennis.center.price</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="center_id"/>
                        <field name="training_type_id"/>
                        <field name="price"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_tennis_center_price" model="ir.actions.act_window">
        <field name="name">Center Prices</field>
        <field name="res_model">tennis.center.price</field>
        <field name="view_mode">list,form</field>
    </record>
    
</odoo>
