<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- List View -->
    <record id="view_tennis_training_session_list" model="ir.ui.view">
        <field name="name">tennis.training.session.list</field>
        <field name="model">tennis.training.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="time_from"/>
                <field name="time_to"/>
                <field name="center_id"/>
                <field name="court_id"/>
                <field name="trainer_id"/>
                <field name="training_type_id"/>
                <field name="price" widget="monetary"/>
                <field name="trainer_cost" widget="monetary"/>
                <field name="revenue" widget="monetary"/>
                <field name="status" decoration-success="status == 'completed'" decoration-info="status == 'confirmed'" decoration-muted="status == 'cancelled'"/>
                <field name="payment_status"/>
            </list>
        </field>
    </record>
    
    <!-- Form View -->
    <record id="view_tennis_training_session_form" model="ir.ui.view">
        <field name="name">tennis.training.session.form</field>
        <field name="model">tennis.training.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Action Buttons -->
                    <button name="action_confirm" string="Confirm" type="object" 
                            class="oe_highlight" 
                            invisible="status != 'draft' or needs_approval"/>
                    
                    <button name="action_approve" string="Approve &amp; Confirm" type="object" 
                            class="oe_highlight" 
                            invisible="status != 'pending_approval' or not needs_approval"/>
                    
                    <button name="action_complete" string="Complete" type="object" 
                            class="oe_highlight" 
                            invisible="status != 'confirmed'"/>
                    
                    <button name="action_cancel" string="Cancel" type="object" 
                            invisible="status in ['completed', 'cancelled']"/>
                    
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" 
                            invisible="status not in ['confirmed', 'cancelled'] or balance_deducted"/>
                    
                    <field name="status" widget="statusbar" statusbar_visible="draft,pending_approval,confirmed,completed"/>
                    <field name="needs_approval" invisible="1"/>
                    <field name="balance_deducted" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <!-- Approval info banner -->
                    <div class="alert alert-warning" role="alert" invisible="not needs_approval">
                        <i class="fa fa-exclamation-triangle"/> This session requires manager approval
                    </div>
                    
                    <group>
                        <group>
                            <field name="center_id"/>
                            <field name="court_id"/>
                            <field name="trainer_id"/>
                            <field name="training_type_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="time_from"/>
                            <field name="time_to"/>
                            <field name="duration"/>
                        </group>
                    </group>
                    <group>
                        <field name="client_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <group>
                            <field name="price" readonly="1" widget="monetary"/>
                            <field name="trainer_cost" readonly="1" widget="monetary"/>
                            <field name="revenue" readonly="1" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="payment_status"/>
                        </group>
                        <group invisible="status != 'completed'">
                            <field name="approved_by" readonly="1"/>
                            <field name="approval_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Additional notes..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <!-- Calendar View -->
    <record id="view_tennis_training_session_calendar" model="ir.ui.view">
        <field name="name">tennis.training.session.calendar</field>
        <field name="model">tennis.training.session</field>
        <field name="arch" type="xml">
            <calendar string="Training Sessions" 
                      date_start="time_from" 
                      date_stop="time_to"
                      color="trainer_id"
                      mode="week">
                <field name="name"/>
                <field name="trainer_id"/>
                <field name="court_id"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>
    
    <!-- Kanban View -->
    <record id="view_tennis_training_session_kanban" model="ir.ui.view">
        <field name="name">tennis.training.session.kanban</field>
        <field name="model">tennis.training.session</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status">
                <field name="name"/>
                <field name="date"/>
                <field name="trainer_id"/>
                <field name="court_id"/>
                <field name="price"/>
                <field name="revenue"/>
                <field name="status"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div><field name="date"/> - <field name="time_from" widget="datetime"/></div>
                                <div>Trainer: <field name="trainer_id"/></div>
                                <div>Court: <field name="court_id"/></div>
                                <div>Price: <field name="price" widget="monetary"/></div>
                                <div>Revenue: <field name="revenue" widget="monetary"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Search View -->
    <record id="view_tennis_training_session_search" model="ir.ui.view">
        <field name="name">tennis.training.session.search</field>
        <field name="model">tennis.training.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="trainer_id"/>
                <field name="center_id"/>
                <field name="court_id"/>
                <filter string="Draft" name="filter_draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Pending Approval" name="filter_pending" domain="[('status', '=', 'pending_approval')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('status', '=', 'confirmed')]"/>
                <filter string="Completed" name="filter_completed" domain="[('status', '=', 'completed')]"/>
                <separator/>
                <filter string="Unpaid" name="filter_unpaid" domain="[('payment_status', '=', 'unpaid')]"/>
                <filter string="Paid" name="filter_paid" domain="[('payment_status', '=', 'paid')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Trainer" name="group_trainer" context="{'group_by': 'trainer_id'}"/>
                    <filter string="Center" name="group_center" context="{'group_by': 'center_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_tennis_training_session" model="ir.actions.act_window">
        <field name="name">Training Sessions</field>
        <field name="res_model">tennis.training.session</field>
        <field name="view_mode">calendar,kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first training session
            </p>
        </field>
    </record>
    
    <!-- Menu Item -->
</odoo>
