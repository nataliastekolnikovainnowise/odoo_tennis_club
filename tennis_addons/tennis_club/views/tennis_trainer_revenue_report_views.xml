<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Report Line Tree View -->
    <record id="view_tennis_trainer_revenue_report_line_tree" model="ir.ui.view">
        <field name="name">tennis.trainer.revenue.report.line.tree</field>
        <field name="model">tennis.trainer.revenue.report.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="trainer_id"/>
                <field name="session_count"/>
                <field name="total_trainer_cost" widget="monetary" sum="Total Cost"/>
                <field name="total_revenue" widget="monetary" sum="Total Revenue"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    
    <!-- Report Form View -->
    <record id="view_tennis_trainer_revenue_report_form" model="ir.ui.view">
        <field name="name">tennis.trainer.revenue.report.form</field>
        <field name="model">tennis.trainer.revenue.report</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button string="Generate Report" 
                                name="action_generate_report" 
                                type="object" 
                                class="oe_stat_button"
                                icon="fa-refresh"/>
                        <button string="Add All Trainers" 
                                name="action_add_all_trainers" 
                                type="object" 
                                class="oe_stat_button"
                                icon="fa-users"
                                groups="tennis_club.group_tennis_director,tennis_club.group_tennis_manager"/>
                    </div>
                    
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="trainer_id" placeholder="All trainers"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Revenue Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="trainer_id"/>
                                    <field name="session_count"/>
                                    <field name="total_trainer_cost" widget="monetary" sum="Total Cost"/>
                                    <field name="total_revenue" widget="monetary" sum="Total Revenue"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group>
                                <group string="Total Summary">
                                    <field name="total_sessions" string="Total Sessions" readonly="1"/>
                                    <field name="total_cost" string="Total Cost" widget="monetary" readonly="1"/>
                                    <field name="total_revenue_sum" string="Total Revenue" widget="monetary" readonly="1"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Report List View -->
    <record id="view_tennis_trainer_revenue_report_list" model="ir.ui.view">
        <field name="name">tennis.trainer.revenue.report.list</field>
        <field name="model">tennis.trainer.revenue.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Created"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="trainer_id"/>
            </list>
        </field>
    </record>
    
    <record id="action_tennis_trainer_revenue_report" model="ir.actions.act_window">
        <field name="name">Trainer Revenue Reports</field>
        <field name="res_model">tennis.trainer.revenue.report</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Trainer Revenue Report
            </p>
        </field>
    </record>
</odoo>
