<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- List View (was tree in Odoo 17) -->
    <record id="view_tennis_training_type_tree" model="ir.ui.view">
        <field name="name">tennis.training.type.list</field>
        <field name="model">tennis.training.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="min_clients"/>
                <field name="max_clients"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    
    <!-- Form View -->
    <record id="view_tennis_training_type_form" model="ir.ui.view">
        <field name="name">tennis.training.type.form</field>
        <field name="model">tennis.training.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="active" widget="boolean_button"
                               options="{'terminology': 'active'}"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Training type name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="min_clients"/>
                            <field name="max_clients"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Description..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_tennis_training_type" model="ir.actions.act_window">
        <field name="name">Training Types</field>
        <field name="res_model">tennis.training.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first training type
            </p>
            <p>
                Define types of trainings available in your tennis clubs
            </p>
        </field>
    </record>
</odoo>
