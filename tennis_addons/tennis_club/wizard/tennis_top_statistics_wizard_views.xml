<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top Statistics Report Form -->
    <record id="view_tennis_top_statistics_report_form" model="ir.ui.view">
        <field name="name">tennis.top.statistics.report.form</field>
        <field name="model">tennis.top.statistics.report</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button string="Generate Report" 
                                name="action_generate_report" 
                                type="object" 
                                class="oe_stat_button"
                                icon="fa-refresh"/>
                    </div>
                    
                    <group>
                        <group>
                            <field name="date_from"/>
                        </group>
                        <group>
                            <field name="date_to"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Statistics">
                            <group string="Most Profitable Trainer">
                                <field name="top_trainer_id" readonly="1"/>
                                <field name="top_trainer_revenue" widget="monetary" readonly="1"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            
                            <group string="Most Popular Training Type">
                                <field name="top_training_type_id" readonly="1"/>
                                <field name="top_training_type_sessions" readonly="1" string="Sessions"/>
                            </group>
                            
                            <group string="Most Active Client">
                                <field name="top_client_id" readonly="1"/>
                                <field name="top_client_sessions" readonly="1" string="Sessions"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- List View -->
    <record id="view_tennis_top_statistics_report_list" model="ir.ui.view">
        <field name="name">tennis.top.statistics.report.list</field>
        <field name="model">tennis.top.statistics.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Created"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="top_trainer_id"/>
                <field name="top_trainer_revenue" widget="monetary"/>
                <field name="top_training_type_id"/>
                <field name="top_client_id"/>
            </list>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_tennis_top_statistics" model="ir.actions.act_window">
        <field name="name">Top Statistics</field>
        <field name="res_model">tennis.top.statistics.report</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
